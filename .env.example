# ============================================================
# ASCON Intelligence Production Configuration Environment
# ============================================================

# Network & Server Port Binding
PORT=3000
HOST=0.0.0.0
APP_URL="http://localhost:3000"

# Multi-Core Scalability & Clustering
# Set to 'true' to enable Node.js multi-process clustering on multi-core servers
CLUSTER_MODE=false
# Number of cluster worker processes (defaults to available CPU cores or max 8)
WEB_CONCURRENCY=2

# Security & Tamper-Proof Vault Salt
# Used to calculate HMAC-SHA256 integrity checksums for all database records
DATABASE_INTEGRITY_KEY="ascon-nist-sp-800-232-vault-secret-replace-in-production"

# Gemma 4 / Google GenAI Integration
# Optional: If omitted, the high-precision built-in local cryptographic coprocessor handles all requests offline
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
